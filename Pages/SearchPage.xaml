<Page x:Class="CN_GreenLumaGUI.Pages.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CN_GreenLumaGUI.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="SearchPage"
      d:DesignHeight="450"
      d:DesignWidth="800"
      FontFamily="/Fonts/#阿里巴巴普惠体"
      mc:Ignorable="d">

    <Page.Resources>
        <!-- 独立模板避免主题按钮的最小尺寸和内边距挤压小图标。 -->
        <Style x:Key="DlcAddButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Page.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding KeyDownEnterCmd}" />
    </Page.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,8,0,16" HorizontalAlignment="Center" Orientation="Horizontal">
            <materialDesign:ColorZone Margin="16,0,0,0"
                                      Padding="8,4,8,4"
                                      Panel.ZIndex="1"
                                      materialDesign:ElevationAssist.Elevation="Dp4"
                                      Mode="Standard"
                                      CornerRadius="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Kind="Search"
                                             Opacity=".56" />
                    <TextBox Grid.Column="1"
                             Width="550"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             materialDesign:HintAssist.Hint="{DynamicResource Search_Placeholder}"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                             MaxLength="128"
                             Text="{Binding SearchBarText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" />

                </Grid>
            </materialDesign:ColorZone>
            <Button Margin="8,0,16,0"
                    Panel.ZIndex="0"
                    Style="{StaticResource MaterialDesignToolForegroundButton}"
                    Command="{Binding SearchButtonCmd}">
                <materialDesign:PackIcon Kind="{Binding SearchButtonIcon}" />
            </Button>
        </StackPanel>
        <DataGrid x:Name="searchResList"
                  Grid.Row="1"
                  GridLinesVisibility="All"
                  ItemsSource="{Binding AppsList}"
                  CanUserAddRows="False"
                  SelectionUnit="Cell"
                  SelectionMode="Extended"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="False"
                  CanUserReorderColumns="False"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  CanUserResizeRows="False"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ColumnWidth="*"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Visible">
            <DataGrid.Columns>
                <DataGridTextColumn Width="Auto" Header="{DynamicResource Search_IndexColumn}" Binding="{Binding DisplayIndex}" />
                <DataGridTemplateColumn Width="120" Header="{DynamicResource Search_CoverColumn}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image HorizontalAlignment="Stretch" Source="{Binding AppImage}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="*" Header="{DynamicResource Search_NameColumn}" Binding="{Binding AppName}" />
                <DataGridTextColumn Width="Auto" Header="{DynamicResource Search_RatingColumn}" Binding="{Binding AppSummary}" />
                <DataGridTemplateColumn Width="Auto" Header="{DynamicResource Search_StorePageColumn}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Width="25"
                                    Height="25"
                                    HorizontalAlignment="Center"
                                    Command="{Binding OpenWebInBrowser}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFloatingActionMiniButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGame}" Value="False">
                                                <Setter Property="Background" Value="#7356B8" />
                                                <Setter Property="BorderBrush" Value="#7356B8" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <materialDesign:PackIcon Width="23" Height="23" Kind="Steam" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="Auto" Header="{DynamicResource Search_AddToListColumn}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Width="45" MinHeight="32">
                                <ToggleButton Width="45"
                                              IsChecked="{Binding IsChecked}"
                                              Command="{Binding ToggleButtonCmd}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignSwitchToggleButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGame}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <materialDesign:PackIcon Kind="Pin" RenderTransformOrigin=".5,.5">
                                        <materialDesign:PackIcon.RenderTransform>
                                            <RotateTransform Angle="45" />
                                        </materialDesign:PackIcon.RenderTransform>
                                    </materialDesign:PackIcon>
                                    <materialDesign:ToggleButtonAssist.OnContent>
                                        <materialDesign:PackIcon Kind="Pin" />
                                    </materialDesign:ToggleButtonAssist.OnContent>
                                </ToggleButton>
                                <Border Width="32" Height="32" Background="Transparent"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        ToolTip="{Binding DlcButtonToolTip}"
                                        PreviewMouseLeftButtonDown="DlcButton_PreviewMouseLeftButtonDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGame}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Style="{StaticResource DlcAddButtonStyle}"
                                            Background="{Binding DlcButtonColor}"
                                            IsEnabled="{Binding CanAddDlc}"
                                            IsHitTestVisible="{Binding CanAddDlc}"
                                            Command="{Binding AddDlcCmd}">
                                        <Viewbox Width="18" Height="18" Stretch="Uniform">
                                            <materialDesign:PackIcon Width="18" Height="18" Kind="{Binding DlcButtonIcon}" />
                                        </Viewbox>
                                    </Button>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="1"
                Margin="0,0,0,5"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Visibility="{Binding FloatButtonVisibility}"
                Command="{Binding FloatButtonCmd}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Margin="0,0,10,0" Kind="{Binding FloatButtonIcon}" />
                <TextBlock Text="{Binding FloatButtonText}" FontSize="12" Foreground="White" />
            </StackPanel>
        </Button>
        <ProgressBar Grid.Row="1"
                     Width="40"
                     Height="40"
                     Margin="0,0,0,10"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                     IsIndeterminate="True"
                     Visibility="{Binding CircularLoadingBarVis}"
                     Value="0" />
        <!--<materialDesign:Snackbar x:Name="SnackbarInform" Grid.Row="1" MessageQueue="{materialDesign:MessageQueue}" />-->
        <ProgressBar Grid.Row="2"
                     Height="5"
                     Margin="0,6,0,5"
                     Visibility="{Binding LoadingBarVis}"
                     Value="{Binding LoadingBarValue}" />
    </Grid>
</Page>
