<Page x:Class="CN_GreenLumaGUI.Pages.AppPoolPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CN_GreenLumaGUI.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="AppPoolPage"
      d:DesignHeight="450"
      d:DesignWidth="800"
      FontFamily="/Fonts/#阿里巴巴普惠体"
      mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 顶部功能区 -->
        <materialDesign:ColorZone Grid.Row="0"
                                  CornerRadius="5"
                                  MaxWidth="800"
                                  Margin="0,0,0,4"
                                  materialDesign:ElevationAssist.Elevation="Dp1">
            <StackPanel Margin="10,8,10,8">
                <!-- 原理说明（可折叠） -->
                <materialDesign:ColorZone Margin="0,0,0,8"
                                          CornerRadius="4"
                                          Background="#FFF8E1"
                                          Padding="10,8,10,8">
                    <StackPanel>
                        <!-- 标题行：始终可见，点击可折叠/展开 -->
                        <Grid Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon VerticalAlignment="Center"
                                                         Margin="0,0,6,0"
                                                         Kind="SwapHorizontalBold"
                                                         Foreground="#E68A00" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="#8A5A00"
                                           Text="{DynamicResource AppPool_PrincipleTitle}" />
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="1"
                                                     Margin="4,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Kind="ChevronDown"
                                                     Foreground="#8A5A00"
                                                     Visibility="{Binding PrincipleBodyVisibility}" />
                            <materialDesign:PackIcon Grid.Column="1"
                                                     Margin="4,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Kind="ChevronRight"
                                                     Foreground="#8A5A00"
                                                     Visibility="{Binding PrincipleCollapsedVisibility}" />
                            <Button Grid.ColumnSpan="2"
                                    Width="Auto"
                                    Height="Auto"
                                    ToolTip="{DynamicResource AppPool_PrincipleToggle}"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Command="{Binding TogglePrincipleCmd}" />
                        </Grid>
                        <!-- 正文：可折叠 -->
                        <StackPanel x:Name="principleBody"
                                    Visibility="{Binding PrincipleBodyVisibility}">
                            <TextBlock Margin="0,4,0,4"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="#7A5200"
                                       Text="{DynamicResource AppPool_PrincipleDetail}" />
                            <TextBlock Margin="0,0,0,4"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="#7A5200"
                                       Text="{DynamicResource AppPool_PrincipleHowTo}" />
                            <TextBlock FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="#7A5200"
                                       Text="{DynamicResource AppPool_PrincipleNote}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="#8A5A00"
                                       Text="{DynamicResource AppPool_PrincipleLocalOnly}" />
                        </StackPanel>
                    </StackPanel>
                </materialDesign:ColorZone>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBox Width="210"
                             VerticalAlignment="Center"
                             MaxLength="12"
                             materialDesign:HintAssist.Hint="{DynamicResource AppPool_AddHint}"
                             Text="{Binding AddAppIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Margin="12,0,0,0"
                            Height="28"
                            Padding="12,0,12,0"
                            Command="{Binding AddAppCmd}"
                            Content="{DynamicResource AppPool_AddButton}" />
                    <TextBlock Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="Gray"
                               Text="{Binding CountText}" />
                    <Button Margin="16,0,0,0"
                            Height="28"
                            Padding="10,0,10,0"
                            Command="{Binding ShowMappingCmd}"
                            ToolTip="{DynamicResource AppPool_MapToolTip}"
                            Content="{DynamicResource AppPool_MapButton}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center"
                              Foreground="Gray"
                              Content="{DynamicResource AppPool_ShowBuiltIn}"
                              IsChecked="{Binding ShowBuiltIn}" />
                    <TextBlock Margin="24,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="Gray"
                               Text="{DynamicResource AppPool_FilterLabel}" />
                    <ComboBox Width="150"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding FilterOptions}"
                              SelectedIndex="{Binding FilterMode}" />
                </StackPanel>
            </StackPanel>
        </materialDesign:ColorZone>
        <!-- 列表 -->
        <ScrollViewer Grid.Row="1"
                      materialDesign:ScrollViewerAssist.IsAutoHideEnabled="True"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="{Binding ScrollBarEchoState}">
            <StackPanel>
                <ItemsControl MaxWidth="800"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Top"
                              ItemsSource="{Binding ItemList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:ColorZone Margin="5,4,5,4"
                                                      materialDesign:ElevationAssist.Elevation="Dp1"
                                                      Mode="Light"
                                                      CornerRadius="5">
                                <StackPanel Orientation="Horizontal" Margin="10,4,10,4">
                                    <CheckBox VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              ToolTip="{DynamicResource AppPool_EnableToolTip}"
                                              IsChecked="{Binding IsEnabled}" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="15"
                                               MinWidth="70"
                                               Foreground="{Binding TextColor}"
                                               Text="{Binding AppIdText}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Margin="6,0,0,0"
                                               FontSize="11"
                                               Foreground="{Binding TextColor}"
                                               Text="{Binding SourceText}" />
                                    <Grid Margin="8,0,0,0" Visibility="{Binding DeleteVisibility}">
                                        <materialDesign:PackIcon HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Kind="Delete"
                                                                 Foreground="#f44b56" />
                                        <Button Command="{Binding DeleteCmd}"
                                                ToolTip="{DynamicResource AppPool_DeleteToolTip}"
                                                Width="22"
                                                Height="22"
                                                BorderThickness="0"
                                                Background="Transparent" />
                                    </Grid>
                                </StackPanel>
                            </materialDesign:ColorZone>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Height="80">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#898989"
                               Text="{Binding PageEndText}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
